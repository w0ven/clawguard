# ========================================
# clawguard 部署环境变量
# ----------------------------------------
# 用法：cp .env.example .env，按注释填值后启动 docker compose
# 标 [必填] 的必须有值；其他有默认或可留空
# __GENERATED__ 占位表示每次部署应生成独立的随机值
#   生成命令：openssl rand -hex 32
# ========================================


# === Telegram ===
# @BotFather 获取
BOT_TOKEN=__TELEGRAM_BOT_TOKEN__
# bot 用户名，不带 @
BOT_USERNAME=your_bot
# Web 管理端登录用的 bot 用户名，一般和 BOT_USERNAME 相同
TELEGRAM_LOGIN_BOT_USERNAME=your_bot
# Telegram webhook 校验密钥 [必填]
WEBHOOK_SECRET=__GENERATED__
# 仅临时诊断 Telegram 原始 update；命中转发/短上下文/💍 消息才记录，默认关闭
CLAWGUARD_LOG_RAW_UPDATES=false
# 超级管理员 Telegram 用户 ID（逗号分隔）；可通过 @userinfobot 获取自己的 ID
SUPER_ADMIN_IDS=123456789
# 普通管理员 Telegram 用户 ID（逗号分隔，可留空）
ADMIN_TELEGRAM_IDS=


# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clawguard
POSTGRES_USER=clawguard
# [必填] 强密码
POSTGRES_PASSWORD=__GENERATED__


# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
# 留空则不鉴权；生产建议设置
REDIS_PASSWORD=__GENERATED__


# === Auth / 加密 ===
# [必填] Web 管理端 JWT 签名密钥
JWT_SECRET=__GENERATED__
# [必填] 加密 DB 里存的 LLM provider api key；生产环境至少 32 字符且必须稳定
ENCRYPTION_KEY=__GENERATED__


# === Cloudflare Turnstile（新人入群验证）===
TURNSTILE_SITE_KEY=__FROM_CLOUDFLARE__
TURNSTILE_SECRET_KEY=__GENERATED_OR_FROM_CLOUDFLARE__


# === LLM Providers ===
# 单行 JSON：[{name, base_url, api_key_env, models}]
# 每个 provider 的 api_key_env 指向下方对应的环境变量名
LLM_PROVIDERS=[{"name":"openai-compatible","base_url":"https://llm.example.com/v1","api_key_env":"LLM_API_KEY","models":["your-model"]}]
LLM_API_KEY=


# === 公网 / 运维 ===
# [必填] Caddy 对外域名，带协议
PUBLIC_BASE_URL=https://your-domain.example
# 可选；管理后台和 webhook 不同域名时填写，留空则使用 PUBLIC_BASE_URL
WEB_BASE_URL=
# 是否给 super admin 发每日报告
DAILY_REPORT_ENABLED=true
# 生产镜像固定到 GitHub Actions 发布的提交标签
CLAWGUARD_TAG=sha-0000000
# 不同数据类型分别保留，不能混用同一个清理周期
RETENTION_VIOLATIONS_DAYS=90
RETENTION_AI_DECISIONS_DAYS=90
RETENTION_CONFIG_AUDIT_DAYS=365
# Bio/资料检查日志保留天数
RETENTION_PROFILE_CHECK_LOGS_DAYS=90
# 归档从未发言的新用户阈值（天）
RETENTION_ZOMBIE_DAYS=30
# 归档已封禁用户阈值（天）
RETENTION_BANNED_DAYS=90
# 主机备份设置；BACKUP_OFFSITE_DIR 留空时只保存在本机
BACKUP_DIR=/var/backups/clawguard
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_DIR=

# ========================================
# clawguard 部署环境变量
# ----------------------------------------
# 用法：cp .env.example .env，按注释填值后启动 docker compose
# 标 [必填] 的必须有值；其他有默认或可留空
# __GENERATED__ 占位表示每次部署应生成独立的随机值
#   生成命令：openssl rand -hex 32
# ========================================


# === Telegram ===
# @BotFather 获取
BOT_TOKEN=8634151493:AAFnF6UntYO28WYt8b11ioITf5SlB2asMTU
# bot 用户名，不带 @
BOT_USERNAME=rfcguard_bot
# Web 管理端登录用的 bot 用户名，一般和 BOT_USERNAME 相同
TELEGRAM_LOGIN_BOT_USERNAME=rfcguard_bot
# Telegram webhook 校验密钥 [必填]
WEBHOOK_SECRET=__GENERATED__
# 仅临时诊断 Telegram 原始 update；命中转发/短上下文/💍 消息才记录，默认关闭
CLAWGUARD_LOG_RAW_UPDATES=false
# 超级管理员 Telegram 用户 ID（逗号分隔）；可通过 @userinfobot 获取自己的 ID
SUPER_ADMIN_IDS=6425070392
# 普通管理员 Telegram 用户 ID（逗号分隔，可留空）
ADMIN_TELEGRAM_IDS=


# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clawguard
POSTGRES_USER=clawguard
# [必填] 强密码
POSTGRES_PASSWORD=__GENERATED__


# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
# 留空则不鉴权；生产建议设置
REDIS_PASSWORD=__GENERATED__


# === Auth / 加密 ===
# [必填] Web 管理端 JWT 签名密钥
JWT_SECRET=__GENERATED__
# 加密 DB 里存的 LLM provider api key（32 字节 hex 或 base64）
# 留空则每次重启用临时 key，已入库的加密 api key 将无法解密
ENCRYPTION_KEY=


# === Cloudflare Turnstile（Web 登录验证码）===
TURNSTILE_SITE_KEY=0x4AAAAAAC_cyx2mqY-lBcuE
TURNSTILE_SECRET_KEY=0x4AAAAAAC_cy7K1kLFAch2oLaTapNsltkQ


# === LLM Providers ===
# 单行 JSON：[{name, base_url, api_key_env, models}]
# 每个 provider 的 api_key_env 指向下方对应的环境变量名
LLM_PROVIDERS=[{"name":"newapi","base_url":"https://newapi.misaka.si/v1","api_key_env":"NEWAPI_KEY","models":["glm-5","minimax-m2.5"]},{"name":"ccproxy","base_url":"https://ccproxy.example/v1","api_key_env":"CCPROXY_KEY","models":["claude-sonnet-4-6"]}]
NEWAPI_KEY=
CCPROXY_KEY=


# === 公网 / 运维 ===
# [必填] Caddy 对外域名，带协议
PUBLIC_BASE_URL=https://guard.misaka.si
# 是否给 super admin 发每日报告
DAILY_REPORT_ENABLED=true
# 归档从未发言的新用户阈值（天）
RETENTION_ZOMBIE_DAYS=30
# 归档已封禁用户阈值（天）
RETENTION_BANNED_DAYS=90

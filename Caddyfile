:80 {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    @mini_verify path /verify/mini
    @non_mini_verify not path /verify/mini
    header @non_mini_verify X-Frame-Options "SAMEORIGIN"
    header @mini_verify -X-Frame-Options
    header @mini_verify Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org"
    header @mini_verify Referrer-Policy "no-referrer"

    @runtime_health path /healthz /readyz
    handle @runtime_health {
        reverse_proxy bot:8080 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 5s
            }
        }
    }

    handle /webhook/* {
        reverse_proxy bot:8080 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }

    handle /api/* {
        reverse_proxy bot:8080 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }

    handle /verify/* {
        reverse_proxy web:3000 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }

    handle {
        reverse_proxy web:3000 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }
}

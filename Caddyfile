:80 {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    @runtime_health path /healthz /readyz
    handle @runtime_health {
        reverse_proxy bot:8080 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 5s
            }
        }
    }

    handle /webhook/* {
        reverse_proxy bot:8080 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }

    handle /api/* {
        reverse_proxy bot:8080 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }

    handle /verify/* {
        reverse_proxy web:3000 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }

    handle {
        reverse_proxy web:3000 {
            lb_try_duration 5s
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }
}
